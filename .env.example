# Environment variables template
# Add any required environment variables below
GEMINI_API_KEY=

# Telegram bot integration (optional): website forms are forwarded to the SSI
# holding bot, which notifies its admins. Leave empty to turn forwarding off.
# BOT_FORMS_URL    = base URL of the bot's HTTP server, e.g. https://bot.example.com
# BOT_FORMS_SECRET = same value as SITE_FORMS_SECRET in the bot's .env
BOT_FORMS_URL=
BOT_FORMS_SECRET=
